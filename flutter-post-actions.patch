+// lib/widgets/post_actions_menu.dart
+import 'package:flutter/material.dart';
+import '../services/api_client.dart';
+
+typedef VoidCallbackAsync = Future<void> Function();
+
+class PostActionsMenu extends StatelessWidget {
+  final String postId;
+  final String currentUserId;
+  final bool isOwner;
+  final ApiClient apiClient;
+  final VoidCallback? onDeleted;
+  final String? idToken; // optional
+
+  const PostActionsMenu({
+    Key? key,
+    required this.postId,
+    required this.currentUserId,
+    required this.isOwner,
+    required this.apiClient,
+    this.onDeleted,
+    this.idToken,
+  }) : super(key: key);
+
+  Future<void> _onEdit(BuildContext context) async {
+    final post = await apiClient.getPostForEdit(postId, idToken: idToken);
+    if (post == null) {
+      ScaffoldMessenger.of(context).showSnackBar(
+        const SnackBar(content: Text('Unable to load post for edit')),
+      );
+      return;
+    }
+    // Navigate to create/edit page and pass the post data as an argument.
+    Navigator.of(context).pushNamed('/createPost', arguments: post);
+  }
+
+  Future<void> _onDelete(BuildContext context) async {
+    final confirmed = await showDialog<bool>(
+      context: context,
+      builder: (ctx) => AlertDialog(
+        title: const Text('Delete post'),
+        content: const Text('Are you sure you want to delete this post? This action cannot be undone.'),
+        actions: [
+          TextButton(onPressed: () => Navigator.of(ctx).pop(false), child: const Text('Cancel')),
+          TextButton(onPressed: () => Navigator.of(ctx).pop(true), child: const Text('Delete')),
+        ],
+      ),
+    );
+    if (confirmed != true) return;
+
+    final success = await apiClient.deletePost(postId, currentUserId, idToken: idToken);
+    if (success) {
+      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Post deleted')));
+      if (onDeleted != null) onDeleted!();
+    } else {
+      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Failed to delete post')));
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (!isOwner) return const SizedBox.shrink();
+    return PopupMenuButton<String>(
+      onSelected: (value) async {
+        if (value == 'edit') {
+          await _onEdit(context);
+        } else if (value == 'delete') {
+          await _onDelete(context);
+        }
+      },
+      itemBuilder: (context) => [
+        const PopupMenuItem(value: 'edit', child: Text('Edit')),
+        const PopupMenuItem(value: 'delete', child: Text('Delete')),
+      ],
+      icon: const Icon(Icons.more_vert),
+    );
+  }
+}
