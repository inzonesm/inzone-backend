+// lib/services/api_client.dart
+import 'dart:convert';
+import 'package:http/http.dart' as http;
+
+class ApiClient {
+  final String baseUrl;
+  final http.Client httpClient;
+
+  ApiClient({required this.baseUrl, http.Client? client})
+      : httpClient = client ?? http.Client();
+
+  Map<String, String> _authHeader([String? idToken]) {
+    final headers = {'Content-Type': 'application/json'};
+    if (idToken != null && idToken.isNotEmpty) {
+      headers['Authorization'] = 'Bearer $idToken';
+    }
+    return headers;
+  }
+
+  /// Fetch a post intended for editing. Returns the JSON body or null on not found.
+  Future<Map<String, dynamic>?> getPostForEdit(String postId, {String? idToken}) async {
+    final uri = Uri.parse('$baseUrl/feed/get-post?post_id=$postId');
+    final res = await httpClient.get(uri, headers: _authHeader(idToken));
+    if (res.statusCode == 200) {
+      final body = json.decode(res.body);
+      return body is Map<String, dynamic> ? body : null;
+    } else {
+      return null;
+    }
+  }
+
+  /// Delete a post. Returns true on success.
+  Future<bool> deletePost(String postId, String userId, {String? idToken}) async {
+    final uri = Uri.parse('$baseUrl/feed/delete-post');
+    final body = json.encode({'PostId': postId, 'UserId': userId});
+    final res = await httpClient.post(uri, headers: _authHeader(idToken), body: body);
+    return res.statusCode == 200;
+  }
+}
+
